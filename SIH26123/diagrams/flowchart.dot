digraph decision {
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="white", label="Robot Decision Loop — SIH26123", labelloc=t, fontsize=20];
  node [fontname="Helvetica", fontsize=11, style="filled"];
  edge [fontname="Helvetica", fontsize=9];

  start [shape=oval, label="Robot boots", fillcolor="#C6F6D5"];
  join [shape=box, style="rounded,filled", label="Join P2P mesh,\nstart heartbeat", fillcolor="#BEE3F8"];
  has_task [shape=diamond, label="Have task?", height=1.1, fillcolor="#FBD38D"];
  listen [shape=box, style="rounded,filled", label="Listen for auctions,\nsubmit bids", fillcolor="#BEE3F8"];
  won [shape=diamond, label="Won bid?", height=1.1, fillcolor="#FBD38D"];
  plan [shape=box, style="rounded,filled", label="Plan: Space-Time A*", fillcolor="#90CDF4"];
  reserve [shape=box, style="rounded,filled", label="Publish intent +\nreserve time windows", fillcolor="#90CDF4"];
  conflict [shape=diamond, label="Conflict /\ndeadlock?", height=1.2, fillcolor="#FEB2B2"];
  prio [shape=diamond, label="Resolvable by\npriority / backoff?", height=1.2, fillcolor="#FEB2B2"];
  yieldn [shape=box, style="rounded,filled", label="Yield / backoff,\nre-reserve", fillcolor="#FED7D7"];
  dbreak [shape=box, style="rounded,filled", label="Deadlock break:\nD* Lite reroute", fillcolor="#FED7D7"];
  move [shape=box, style="rounded,filled", label="Move along path", fillcolor="#68D391"];
  blocked [shape=diamond, label="Aisle blocked?", height=1.1, fillcolor="#FEB2B2"];
  replan [shape=box, style="rounded,filled", label="Replan (D* Lite);\nauction my task if stuck", fillcolor="#FED7D7"];
  done [shape=box, style="rounded,filled", label="Release reservations,\nreport completion", fillcolor="#68D391"];
  hb [shape=diamond, label="Peer heartbeats OK?", height=1.2, fillcolor="#FBD38D"];
  takeover [shape=box, style="rounded,filled", label="Lost peer:\nbid on its orphaned tasks", fillcolor="#FED7D7"];

  start -> join -> has_task;
  has_task -> listen [label="no"];
  listen -> won;
  won -> plan [label="yes"];
  won -> has_task [label="no", constraint=false];
  has_task -> plan [label="yes"];
  plan -> reserve;
  reserve -> conflict;
  conflict -> move [label="no"];
  conflict -> prio [label="yes"];
  prio -> yieldn [label="yes"];
  prio -> dbreak [label="no"];
  yieldn -> reserve;
  dbreak -> reserve;
  move -> blocked [label="each step"];
  blocked -> replan [label="yes"];
  blocked -> done [label="goal reached"];
  replan -> reserve;
  done -> has_task;
  move -> hb;
  hb -> takeover [label="lost peer"];
  hb -> move [label="ok", constraint=false];
  takeover -> has_task;
}
