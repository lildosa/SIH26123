digraph roadmap {
  rankdir=LR;
  graph [fontname="Helvetica", bgcolor="white", ranksep=0.35, nodesep=0.25,
         label="36-Hour Build Roadmap — SIH26123 (parallel tracks)", labelloc=t, fontsize=20];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", width=2.2];

  subgraph cluster_track1 {
    label="Track A — World & Sim"; style="rounded,filled"; fillcolor="#FFF5F5"; color="#C53030"; fontsize=12;
    a1 [label="H0–3 · Grid world +\nwarehouse generator", fillcolor="#FED7D7"];
    a2 [label="H3–8 · Robot kinematics,\nscenario injector", fillcolor="#FED7D7"];
    a3 [label="H12+ · Polish scripted\ndemo scenarios", fillcolor="#FED7D7"];
    a1 -> a2 -> a3;
  }

  subgraph cluster_track2 {
    label="Track B — Planning & Conflict (strongest dev)"; style="rounded,filled"; fillcolor="#EBFBF3"; color="#276749"; fontsize=12;
    b1 [label="H3–7 · Space-time A*", fillcolor="#C6F6D5"];
    b2 [label="H7–12 · Reservation tables\nat intersections", fillcolor="#C6F6D5"];
    b3 [label="H12–16 · Deadlock detect + break\n(wait-for graph, aging)"];
    b4 [label="H16–19 · D* Lite replanning"];
    b5 [label="(stretch) CBS optimal MAPF", style="dashed,rounded,filled"];
    b1 -> b2 -> b3 -> b4 -> b5;
  }

  subgraph cluster_track3 {
    label="Track C — Comms & Allocation"; style="rounded,filled"; fillcolor="#EBF4FF"; color="#2B6CB0"; fontsize=12;
    c1 [label="H2–6 · ZeroMQ mesh,\ndiscovery, heartbeats", fillcolor="#BEE3F8"];
    c2 [label="H6–10 · Intent/reservation\nmessage protocol", fillcolor="#BEE3F8"];
    c3 [label="H16–20 · Contract-net auctions\n+ lost-peer takeover"];
    c1 -> c2 -> c3;
  }

  subgraph cluster_track4 {
    label="Track D — Metrics & Demo"; style="rounded,filled"; fillcolor="#FFFFF0"; color="#975A16"; fontsize=12;
    d1 [label="H6–9 · Baseline mode\n(stop-and-wait toggle)", fillcolor="#FEEBC8"];
    d2 [label="H9–17 · Dashboard + live metrics", fillcolor="#FEEBC8"];
    d3 [label="H24–28 · Side-by-side comparison,\npitch deck", fillcolor="#FEEBC8"];
    d4 [label="H28–32 · Edge deploy on Pis /\nlaptops + profiling", fillcolor="#FEEBC8"];
    d1 -> d2 -> d3 -> d4;
  }

  sync1 [shape=diamond, label="H8 sync:\nrobots move in world", height=1.4, fillcolor="#E9D8FD"];
  sync2 [shape=diamond, label="H16 sync:\n3 robots negotiate\none intersection", height=1.6, fillcolor="#E9D8FD"];
  sync3 [shape=diamond, label="H32 freeze:\nfeature lock", height=1.4, fillcolor="#E9D8FD"];

  a2 -> sync1;
  c1 -> sync1;
  b2 -> sync2;
  c2 -> sync2;
  a3 -> sync3;
  d3 -> sync3;
  b4 -> d4 [style=invis];
}
